# Web (Next.js, deployed to Netlify)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional HMAC key for signed client-IP headers. Use the same 32+ character
# high-entropy value as the API's AUTH_PROXY_SECRET. Unset/mismatched/short =
# no signed IPs; the API keeps its shared rate-limit bucket (rate limiting is
# always enabled).
AUTH_PROXY_SECRET=
