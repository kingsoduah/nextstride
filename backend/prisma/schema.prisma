// NextStride Prisma schema — PostgreSQL (Netlify Postgres).
// Better Auth tables (User/Session/Account/Verification) + PRD §24 app models.
// Migrations: `npx prisma migrate dev` from backend/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Better Auth (managed by the auth library; do not hand-edit columns casually) ---
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  situations    Situation[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// --- NextStride app models (PRD §24) ---
model Situation {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  // Owner-set display name for the sidebar (Phase D rename). Null = no custom
  // name yet; clients fall back to a slice of `text`. Rename never touches
  // `text`, so messages, recommendations, snapshots and history stay intact.
  title           String?
  confirmed       Boolean           @default(false)
  context         SituationContext?
  recommendations Recommendation[]
  reassessments   Reassessment[]
  feedback        Feedback?
  decisionContexts DecisionContext[]
  recommendationsV2 RecommendationV2[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, createdAt])
}

model SituationContext {
  id              String           @id @default(cuid())
  situationId     String           @unique
  situation       Situation        @relation(fields: [situationId], references: [id], onDelete: Cascade)
  uncertainties   String[]         @default([])
  responsibilities Responsibility[]
  conflicts       Conflict[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Responsibility {
  id          String           @id @default(cuid())
  contextId   String
  context     SituationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  title       String
  category    String           @default("other")
  timeRef     String           @default("")
  fixedTime   Boolean          @default(false)
  flexible    Boolean          @default(true)
  delegatable Boolean          @default(false)
  detail      String

  @@index([contextId])
}

model Conflict {
  id          String           @id @default(cuid())
  contextId   String
  context     SituationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  description String
  involves    String[]         @default([])

  @@index([contextId])
}

model Recommendation {
  // Immutable by convention: never UPDATE, only INSERT with version = max + 1.
  id                  String    @id @default(cuid())
  situationId         String
  situation           Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  version             Int
  recommendedPriority String
  why                 String
  nextAction          String
  others              Json      @default("[]")
  reassessIf          String[]  @default([])
  uncertaintyNotes    String    @default("")
  promptVersion       String    @default("v1")
  createdAt           DateTime  @default(now())

  @@unique([situationId, version])
  @@index([situationId, version])
}

model Reassessment {
  id          String    @id @default(cuid())
  situationId String
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  updateText  String
  createdAt   DateTime  @default(now())

  @@index([situationId, createdAt])
}

model Feedback {
  id          String    @id @default(cuid())
  situationId String    @unique
  situation   Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  helpful     Boolean
  note        String    @default("")
  createdAt   DateTime  @default(now())
}

model AiRun {
  // Observability per PRD §33. Never store raw user PII beyond IDs.
  id               String   @id @default(cuid())
  situationId      String?
  kind             String
  provider         String   @default("groq")
  model            String   @default("")
  promptVersion    String   @default("v1")
  status           String
  latencyMs        Int      @default(0)
  validationErrors String   @default("")
  createdAt        DateTime @default(now())

  @@index([situationId, createdAt])
}

// --- NextStride V2: versioned structured decision contexts (Phase 2+) ---
// V1 SituationContext rows are NEVER modified by V2. Each parse appends a new
// version, giving reassessment history (Phase 6) and V1-vs-V2 comparison
// (Phase 7) for free. The structured context itself is JSON to avoid
// premature relational complexity; later phases add tables only as justified.
model DecisionContext {
  id            String   @id @default(cuid())
  situationId   String
  situation     Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  version       Int
  timezone      String   @default("Africa/Lagos")
  reference     Json
  context       Json
  resolutions   Json     @default("{}")
  questions     String[] @default([])
  provider      String   @default("")
  promptVersion String   @default("")
  createdAt     DateTime @default(now())

  @@unique([situationId, version])
  @@index([situationId, version])
}

// --- NextStride V2: versioned AI recommendations (Phase 4) ---
// Mirrors the DecisionContext versioning pattern: immutable rows, never
// UPDATE - only INSERT with version = max + 1. Each row pins the context
// version and analysis snapshot it reasoned over, plus the previous
// recommendation id for the reassessment chain. V1 Recommendation untouched.
model RecommendationV2 {
  id             String   @id @default(cuid())
  situationId    String
  situation      Situation @relation(fields: [situationId], references: [id], onDelete: Cascade)
  version        Int
  contextVersion Int
  analysis       Json
  payload        Json
  status         String   @default("")
  previousId     String?
  provider       String   @default("")
  promptVersion  String   @default("")
  createdAt      DateTime @default(now())

  @@unique([situationId, version])
  @@index([situationId, version])
}
