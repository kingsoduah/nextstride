# API (NestJS). Never commit real values.
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/nextstride
BETTER_AUTH_SECRET=replace-with-32-plus-char-random-secret
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Phase 8.5 Model Lab (all optional; absent providers are simply unavailable).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
# Auto priority when configured: groq (GROQ_MODEL), then gemini (GEMINI_MODEL).
# OpenRouter is temporarily parked pre-deployment (see PARKED_PROVIDERS in
# backend/src/ai/provider-registry.ts): still integrated and configurable,
# but excluded from Auto and readiness until its free tier stabilizes.
# Re-enable by removing it from PARKED_PROVIDERS — the free models in order
# would then be: nvidia/nemotron-3-super-120b-a12b:free,
# google/gemma-4-26b-a4b-it:free.
# (inclusionai/ling-*:free never existed — InclusionAI has no free tier.)
# Opt-in live benchmark only (never CI): NEXTSTRIDE_LIVE_BENCHMARK=1
NEXTSTRIDE_LIVE_BENCHMARK=
# Optional HMAC key for the signed client-IP hand-off (backend/src/auth/client-ip.ts
# and frontend/middleware.ts). Use the same 32+ character high-entropy value on
# the Netlify site and this API. When unset/mismatched/short, signed IPs are
# refused and Better Auth uses one shared per-path rate-limit bucket. Rate
# limiting itself is always enabled and never depends on NODE_ENV.
AUTH_PROXY_SECRET=
